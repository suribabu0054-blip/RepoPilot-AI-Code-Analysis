# RepoPilot Environment Variables Configuration
# Copy this file to .env and fill in your actual credentials

# ============================================
# IBM watsonx.ai Configuration (Optional)
# ============================================
# RepoPilot works without these credentials using local rule-based analysis.
# To enable AI-powered analysis with IBM Granite models, configure these:

# Your IBM Cloud API Key
# Get it from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_api_key_here

# Your watsonx.ai Project ID
# Get it from your watsonx.ai project settings
WATSONX_PROJECT_ID=your_project_id_here

# watsonx.ai API Endpoint (Optional)
# Default: https://us-south.ml.cloud.ibm.com
# Other regions: https://eu-gb.ml.cloud.ibm.com, https://jp-tok.ml.cloud.ibm.com
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ============================================
# Other AI API Keys (Future Enhancements)
# ============================================
# OPENAI_API_KEY=your_openai_key_here
# GROQ_API_KEY=your_groq_key_here

# ============================================
# Application Settings
# ============================================
MAX_CODE_LENGTH=10000
ENABLE_LOGGING=true